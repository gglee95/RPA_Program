            print(f"[INFO] BeForward 濡쒓렇?? {BEFORWARD_LOGIN_URL}")
            self.driver.get(BEFORWARD_LOGIN_URL)
            time.sleep(1)

            wait = WebDriverWait(self.driver, self.WAIT_TIMEOUT)

