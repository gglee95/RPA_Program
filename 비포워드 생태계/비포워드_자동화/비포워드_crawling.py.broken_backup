    def _fill_text(self, by, selector, value: str, label: str = "") -> bool:
        if not value:
            return True
        try:
            field = self.driver.find_element(by, selector)
            self.driver.execute_script("arguments[0].value = '';", field)
            field.send_keys(value)
            print(f"  {label}: '{value}'")
            return True
        except NoSuchElementException:
            print(f"  [寃쎄퀬] {label} ?꾨뱶 ?놁쓬 ({selector})")
            return False

    # ?? ?ы띁: select value ?좏깮 ????????????????????????????????????????
    def _select_by_value(self, by, selector, value: str, label: str = "") -> bool:
        if not value:
            return True
        try:
            sel = Select(self.driver.find_element(by, selector))
            sel.select_by_value(value)
            print(f"  {label}: '{value}'")
            return True
        except (NoSuchElementException, Exception) as e:
            print(f"  [寃쎄퀬] {label} ?좏깮 ?ㅽ뙣: {e}")
            return False

    # ?? ?ы띁: select ?띿뒪??遺遺??쇱튂 ?좏깮 ???????????????????????????
    def _select_by_text_partial(self, by, selector, text: str, label: str = "", suppress_log: bool = False) -> bool:
        if not text:
            return True
        try:
            sel = Select(self.driver.find_element(by, selector))
            options = sel.options
            text_lower = text.lower()
            for opt in options:
                if text_lower in opt.text.lower():
                    sel.select_by_visible_text(opt.text)
                    print(f"  {label}: '{opt.text}'")
                    return True
            if not suppress_log:
                print(f"  [寃쎄퀬] {label} ?듭뀡 ?놁쓬 (寃?? '{text}')")
            return False
        except NoSuchElementException:
            if not suppress_log:
                print(f"  [寃쎄퀬] {label} select ?놁쓬 ({selector})")
            return False

    def _select_by_text_candidates(
