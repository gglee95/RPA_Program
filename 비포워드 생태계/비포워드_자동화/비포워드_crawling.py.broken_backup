                self.driver.execute_script("arguments[0].click();", btn)
            if self._wait_for_condition_page_ready():
                print(f"  [OK] ?깅뒫 ?섏씠吏 ?대룞 ?꾨즺 ({target_xpath})")
                return True
            print(f"  [寃쎄퀬] ?깅뒫 ?섏씠吏 ?대룞 ?대┃ ???꾩갑 ?뺤씤 ?ㅽ뙣 ({target_xpath})")
            return False
        except Exception as e:
            if self._wait_for_condition_page_ready():
                print(f"  [OK] ?대┃ ?덉쇅 ?꾩뿉???깅뒫 ?섏씠吏 ?꾩갑 ?뺤씤")
                return True
            print(f"  [寃쎄퀬] ?깅뒫 ?섏씠吏 ?대룞 ?대┃ ?ㅽ뙣: {e}")
            return False

    def _is_condition_page_ready(self) -> bool:
        """?꾩옱 ?섏씠吏媛 ?깅뒫 ?섏씠吏?몄? 鍮좊Ⅴ寃??먮퀎?쒕떎."""
        condition_xpaths = [
            '//*[@id="condition-form"]',
            '//*[@id="condition-form"]/div[2]/div/button',
        ]
        for xpath in condition_xpaths:
            try:
                elem = self.driver.find_element(By.XPATH, xpath)
                if elem.is_displayed():
                    return True
            except Exception:
                continue
        return False

    def _wait_for_condition_page_ready(self, timeout: int = 5) -> bool:
        """?깅뒫 ?섏씠吏 ?꾩갑 ?щ?瑜??좎떆 湲곕떎?몃떎媛 ?뺤씤?쒕떎."""
        end_time = time.time() + timeout
        while time.time() < end_time:
            if self._is_condition_page_ready():
                return True
            time.sleep(0.3)
        return False

    def _save_after_condition_page(self) -> bool:
        """?깅뒫 ?섏씠吏 ?낅젰 ?????踰꾪듉???대┃?쒕떎."""
        save_xpaths = [
            '//*[@id="condition-form"]/div[2]/div/button',
            '//*[@id="bulk_confirm_form"]/div/button',
            SUBMIT_BUTTON_XPATH,
            "//button[@type='submit']",
            "//input[@type='submit']",
        ]
        for xpath in save_xpaths:
            try:
                save_btn = self.driver.find_element(By.XPATH, xpath)
                if not save_btn.is_displayed():
                    continue
                self.driver.execute_script("""
                    arguments[0].removeAttribute('disabled');
                    arguments[0].scrollIntoView({block:'center'});
                """, save_btn)
                time.sleep(0.5)
                try:
                    save_btn.click()
                except Exception:
                    self.driver.execute_script("arguments[0].click();", save_btn)
                print(f"[OK] ?깅뒫 ?섏씠吏 ???踰꾪듉 ?대┃ ?꾨즺: {xpath[:50]}")
                time.sleep(1.5)
                self._dismiss_popup()
                return True
            except Exception:
                continue
        return False

    def _dismiss_popup(self) -> str:
        """??????섑??섎뒗 ?앹뾽/alert ?リ린. alert ?띿뒪?몃? 諛섑솚."""
        POPUP_CLOSE_XPATH = '//*[@id="lightbox"]/div[2]/div/div[2]/a[1]'

        # 1. JS alert 泥섎━
        try:
            alert = self.driver.switch_to.alert
            alert_text = alert.text or ""
            print(f"  [OK] Alert ?앹뾽 ?リ린: {alert_text[:80]}")
            alert.accept()
            time.sleep(0.3)
            return alert_text
        except Exception:
            pass

        # 2. lightbox ?앹뾽 ?リ린 踰꾪듉
        try:
            close_btn = WebDriverWait(self.driver, 5).until(
                EC.element_to_be_clickable((By.XPATH, POPUP_CLOSE_XPATH))
            )
            close_btn.click()
            print(f"  [OK] ?앹뾽 ?リ린 ?꾨즺 (lightbox)")
            time.sleep(0.3)
            return ""
        except Exception:
            pass

        # 3. fallback
        for xpath in ["//button[contains(@class,'close')]", "//a[contains(@class,'close')]"]:
            try:
                btn = self.driver.find_element(By.XPATH, xpath)
                if btn.is_displayed():
                    btn.click()
                    print(f"  [OK] ?앹뾽 ?リ린 ?꾨즺: {xpath[:60]}")
                    time.sleep(0.3)
                    return ""
            except Exception:
                continue
        print("  [INFO] ?レ쓣 ?앹뾽 ?놁쓬 (?뺤긽)")
        return ""

    def _dump_form_fields(self) -> None:
        """?쇱쓽 紐⑤뱺 select/input ?꾨뱶 ?대쫫??異쒕젰 (?붾쾭洹몄슜)"""
        try:
            result = self.driver.execute_script("""
                const fields = {selects: [], inputs: [], radios: [], checkboxes: []};
                document.querySelectorAll('select').forEach(el => {
                    const name = el.getAttribute('name') || '';
                    const id = el.getAttribute('id') || '';
                    const opts = Array.from(el.options).slice(0, 5).map(o => o.text.trim()).filter(Boolean);
                    fields.selects.push({name, id, options: opts});
                });
                document.querySelectorAll('input[type="text"], input[type="number"], input[type="hidden"], textarea').forEach(el => {
                    const name = el.getAttribute('name') || '';
                    const id = el.getAttribute('id') || '';
                    const val = el.value || '';
                    if (name) fields.inputs.push({name, id, value: val.substring(0, 30)});
                });
                document.querySelectorAll('input[type="radio"]').forEach(el => {
                    const name = el.getAttribute('name') || '';
                    const val = el.value || '';
                    const label = el.closest('label')?.textContent?.trim() || '';
                    if (name) fields.radios.push({name, value: val, label: label.substring(0, 30)});
                });
                return fields;
            """)

            print("\n" + "=" * 60)
            print("[DEBUG] 鍮꾪룷?뚮뱶 ???꾨뱶 紐⑸줉")
            print("=" * 60)

            print("\n?? SELECT ?꾨뱶 ??")
            for s in result.get('selects', []):
                opts_str = ', '.join(s['options'][:3])
                print(f"  name='{s['name']}' id='{s['id']}' opts=[{opts_str}]")

            print("\n?? INPUT/TEXTAREA ?꾨뱶 ??")
            for inp in result.get('inputs', []):
                print(f"  name='{inp['name']}' id='{inp['id']}' val='{inp['value']}'")

            print("\n?? RADIO ?꾨뱶 ??")
            for r in result.get('radios', []):
                print(f"  name='{r['name']}' value='{r['value']}' label='{r['label']}'")

            print("=" * 60 + "\n")

        except Exception as e:
            print(f"[寃쎄퀬] ???꾨뱶 ?ㅽ봽 ?ㅽ뙣: {e}")

