        return candidates

    def _normalize_body_type_alias(self, body_type: str) -> str:
        body_type = (body_type or "").strip()
        if not body_type:
            return ""
        return BODY_TYPE_ALIASES.get(body_type.lower(), body_type)

    def _get_body_type_candidates(self, local_spec: dict, car_type: str) -> list[str]:
        candidates = []

        def add_candidate(value: str):
            value = (value or "").strip()
            if value and value not in candidates:
                candidates.append(value)

        local_body_type = (local_spec or {}).get('body_type', '')
        add_candidate(local_body_type)

        canonical_body_type = self._normalize_body_type_alias(local_body_type)
        if canonical_body_type:
            for value in self._get_body_type_text_candidates(canonical_body_type):
                add_candidate(value)
        else:
            body_type = self._get_body_type(car_type)
            for value in self._get_body_type_text_candidates(body_type):
                add_candidate(value)

        return candidates

