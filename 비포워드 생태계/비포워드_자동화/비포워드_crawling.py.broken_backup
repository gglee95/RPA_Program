    def _get_uploaded_image_count(self) -> int:
        """?꾩옱 ?붾㈃???쒖떆???낅줈???대?吏 ?섎? ????쇰떎."""
        try:
            return int(self.driver.execute_script("""
                var selectors = [
                    '#public_pane img',
                    '#public_pane li img',
                    '#public_pane .uploaded img',
                    '.uploaded img',
                    'img[src*="upload"]',
                    'img[src*="photo"]'
                ];
                var nodes = [];
                selectors.forEach(function(sel) {
                    document.querySelectorAll(sel).forEach(function(node) {
                        if (!nodes.includes(node)) nodes.push(node);
                    });
                });
                var count = 0;
                nodes.forEach(function(node) {
                    var src = (node.getAttribute('src') || '').toLowerCase();
                    if (!src) return;
                    if (src.includes('icon') || src.includes('logo') || src.includes('blank')) return;
                    count += 1;
                });
                return count;
            """) or 0)
        except Exception:
            return 0

    def _wait_for_uploaded_image_count(self, before_count: int, timeout: int = 12) -> int:
        """?낅줈????蹂댁씠???대?吏 ?섍? 利앷????뚭퉴吏 ?좎떆 ?湲고븳??"""
        end = time.time() + timeout
        last_count = before_count
        while time.time() < end:
            last_count = self._get_uploaded_image_count()
            if last_count > before_count:
                return last_count
            time.sleep(0.5)
        return last_count

    def _wait_for_final_uploaded_images(
        self,
        expected_min_count: int,
        timeout: int = 45,
        stable_seconds: int = 4,
    ) -> int:
        """?깅뒫?섏씠吏濡??섏뼱媛湲??꾩뿉 ?대?吏 媛쒖닔媛 ?덉젙?붾맆 ?뚭퉴吏 湲곕떎由곕떎."""
        end = time.time() + timeout
        stable_start = None
        last_count = self._get_uploaded_image_count()

        while time.time() < end:
            current_count = self._get_uploaded_image_count()

            if current_count != last_count:
                print(f"  [DEBUG] ?대?吏 媛쒖닔 蹂寃?媛먯?: {last_count} -> {current_count}")
                last_count = current_count
                stable_start = None
            elif current_count >= expected_min_count:
                if stable_start is None:
                    stable_start = time.time()
                elif time.time() - stable_start >= stable_seconds:
                    return current_count

            time.sleep(0.5)

        return last_count

