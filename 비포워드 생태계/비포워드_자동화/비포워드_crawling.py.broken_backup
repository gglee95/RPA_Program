        try:
            sel = Select(self.driver.find_element(by, selector))
            valid_opts = [o for o in sel.options if o.text.strip() and o.get_attribute('value')]
            if not valid_opts:
                return False

            best_text = ""
            best_score = 0.0
            for cand in candidates:
                c_norm = self._normalize_key(cand)
                if not c_norm:
                    continue
                for opt in valid_opts:
                    o_text = opt.text.strip()
                    o_norm = self._normalize_key(o_text)
                    if not o_norm:
                        continue
                    if c_norm in o_norm or o_norm in c_norm:
                        score = 0.95
                    else:
                        score = SequenceMatcher(None, c_norm, o_norm).ratio()
                    if score > best_score:
                        best_score = score
                        best_text = o_text

            if best_text and best_score >= 0.55:
                sel.select_by_visible_text(best_text)
                print(f"  {label}: '{best_text}'")
                return True
            return False
        except Exception:
            return False

