    def _get_model_name(self, car_type: str) -> str:
        if not car_type:
            return ""
        parts = [p for p in car_type.strip().split() if p]
        if not parts:
            return ""

        model_token = ""
        for token in parts:
            token_lower = token.lower()
            if token_lower in MODEL_PREFIX_STOPWORDS:
                continue
            if re.fullmatch(r'[\d.]+', token):
                continue
            if re.search(r'[A-Za-z媛-??', token):
                model_token = token
                break

        if not model_token:
            return ""

        for suffix in MODEL_SUFFIX_STOPWORDS:
            if model_token.lower().endswith(suffix):
                model_token = model_token[:-len(suffix)]
                break

        return model_token.strip()

