        text = car_type.strip()
        parts = text.split()
        if not parts:
            return ""

        if parts[0] in MAKE_MAP:
            parts = parts[1:]
        while parts and parts[0].lower() in MODEL_PREFIX_STOPWORDS:
            parts = parts[1:]
        if parts:
            parts = parts[1:]
        grade = " ".join(parts).strip()
        if model_hint:
            grade = grade.replace(model_hint, "", 1).strip()
        return grade

